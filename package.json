{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "scrape": "tsx scripts/scraper/cli.ts",
    "scrape:plan": "tsx scripts/scraper/cli.ts plan",
    "scrape:status": "tsx scripts/scraper/cli.ts status",
    "scrape:verify": "tsx scripts/scraper/cli.ts verify",
    "scrape:emit": "tsx scripts/scraper/cli.ts emit",
    "scrape:test": "tsx scripts/scraper/selftest.ts",
    "scrape:report": "tsx scripts/scraper/cli.ts report",
    "scrape:e2e": "tsx scripts/scraper/e2e.ts",
    "scrape:push": "tsx scripts/scraper/cli.ts push",
    "test": "bun test",
    "build:preview": "vite build --mode preview",
    "deploy:preview": "bun run build:preview && wrangler deploy --env preview",
    "deploy:prod": "bun run build && wrangler deploy --env production"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
